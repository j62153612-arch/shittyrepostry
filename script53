----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local STATE = {
	speed = { on = false, method = 1, value = 50 },
	jump  = { on = false, method = 1, value = 100 },
	fly   = { on = false, method = 1, value = 60 },
	noclip = { on = false, method = 1, value = 0 },
}
local F, objs, conns = {}, {}, {}

local function track(key, o)
	objs[key] = objs[key] or {}
	table.insert(objs[key], o)
	return o
end

local function cleanup(key)
	for _, o in ipairs(objs[key] or {}) do
		pcall(function()
			if typeof(o) == "RBXScriptConnection" then o:Disconnect() else o:Destroy() end
		end)
	end
	objs[key] = {}
end

local function getChar()
	local c = lp.Character
	if not c then return end
	return c, c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

----------------------------------------------------------------------
-- SPEED
----------------------------------------------------------------------
local ws = {}
F.speed = {
	start = function()
		local c, hum, hrp = getChar()
		if not (hum and hrp) then return end
		local m = STATE.speed.method
		if m == 1 then
			ws.orig = hum.WalkSpeed
		elseif m == 5 then
			local att = track("speed", Instance.new("Attachment"))
			att.Parent = hrp
			local lv = track("speed", Instance.new("LinearVelocity"))
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
			lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
			lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
			lv.MaxForce = 1e7
			lv.Enabled = false
			lv.Parent = hrp
			ws.lv = lv
		end
	end,

	stop = function()
		cleanup("speed")
		local _, hum = getChar()
		if hum and ws.orig then hum.WalkSpeed = ws.orig end
		ws.orig, ws.lv = nil, nil
	end,

	step = function(dt)
		local c, hum, hrp = getChar()
		if not (hum and hrp) then return end
		local m, v = STATE.speed.method, STATE.speed.value
		local dir = hum.MoveDirection
		if m == 1 then
			if hum.WalkSpeed ~= v then hum.WalkSpeed = v end
		elseif m == 2 then
			if dir.Magnitude > 0 then hrp.CFrame = hrp.CFrame + dir * v * dt end
		elseif m == 3 then
			if dir.Magnitude > 0 then
				local y = hrp.AssemblyLinearVelocity.Y
				hrp.AssemblyLinearVelocity = Vector3.new(dir.X * v, y, dir.Z * v)
			end
		elseif m == 4 then
			if dir.Magnitude > 0 then c:TranslateBy(dir * v * dt) end
		elseif m == 5 then
			local lv = ws.lv
			if lv and lv.Parent then
				if dir.Magnitude > 0 then
					lv.Enabled = true
					lv.PlaneVelocity = Vector2.new(dir.X * v, dir.Z * v)
				else
					lv.Enabled = false
				end
			end
		end
	end,
}

----------------------------------------------------------------------
-- JUMP
----------------------------------------------------------------------
local jp = {}

local function doJump()
	local _, hum, hrp = getChar()
	if not (hum and hrp) then return end
	local m, v = STATE.jump.method, STATE.jump.value
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	if (m == 3 and grounded) or m == 5 then
		task.defer(function()
			RunService.Heartbeat:Wait() -- let the humanoid apply its own jump first
			if hrp and hrp.Parent then
				local vel = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(vel.X, v, vel.Z)
			end
		end)
	elseif m == 4 and grounded then
		hrp:ApplyImpulse(Vector3.new(0, v * hrp.AssemblyMass, 0))
	end
end

F.jump = {
	start = function()
		local _, hum = getChar()
		if not hum then return end
		local m = STATE.jump.method
		if m == 1 or m == 2 then
			jp.useJP, jp.jp, jp.jh = hum.UseJumpPower, hum.JumpPower, hum.JumpHeight
		else
			track("jump", UIS.JumpRequest:Connect(doJump))
		end
	end,

	stop = function()
		cleanup("jump")
		local _, hum = getChar()
		if hum and jp.useJP ~= nil then
			hum.UseJumpPower = jp.useJP
			hum.JumpPower = jp.jp
			hum.JumpHeight = jp.jh
		end
		jp.useJP, jp.jp, jp.jh = nil, nil, nil
	end,

	step = function()
		local m, v = STATE.jump.method, STATE.jump.value
		if m ~= 1 and m ~= 2 then return end
		local _, hum = getChar()
		if not hum then return end
		if m == 1 then
			if hum.UseJumpPower ~= true then hum.UseJumpPower = true end
			if hum.JumpPower ~= v then hum.JumpPower = v end
		else
			if hum.UseJumpPower ~= false then hum.UseJumpPower = false end
			if hum.JumpHeight ~= v then hum.JumpHeight = v end
		end
	end,
}

----------------------------------------------------------------------
-- FLY
----------------------------------------------------------------------
local fl = { up = false, down = false }

local function flyDir(hum)
	local cam = workspace.CurrentCamera
	local dir = hum.MoveDirection -- flat, already relative to the camera
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	local vert = (fl.up and 1 or 0) - (fl.down and 1 or 0)
	if flat.Magnitude > 0.05 and dir.Magnitude > 0 then
		-- pushing forward/back while looking up/down also moves you up/down
		local f = dir:Dot(flat.Unit)
		vert = vert + f * (look.Y / flat.Magnitude)
	end
	local d = dir + Vector3.new(0, vert, 0)
	if d.Magnitude > 1 then d = d.Unit end
	return d
end

local function face(pos)
	-- full camera direction, including looking up/down
	local look = workspace.CurrentCamera.CFrame.LookVector
	local up = (math.abs(look.Y) > 0.99) and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
	return CFrame.lookAt(pos, pos + look, up)
end

F.fly = {
	start = function()
		local c, hum, hrp = getChar()
		if not (hum and hrp) then return end
		local m = STATE.fly.method
		if m == 1 then
			local att = track("fly", Instance.new("Attachment"))
			att.Parent = hrp
			local lv = track("fly", Instance.new("LinearVelocity"))
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.MaxForce = math.huge
			lv.VectorVelocity = Vector3.zero
			lv.Parent = hrp
			local ao = track("fly", Instance.new("AlignOrientation"))
			ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
			ao.Attachment0 = att
			ao.MaxTorque = math.huge
			ao.Responsiveness = 50
			ao.CFrame = face(hrp.Position)
			ao.Parent = hrp
			fl.lv, fl.ao = lv, ao
			hum.PlatformStand = true
		end
	end,

	stop = function()
		cleanup("fly")
		fl.lv, fl.ao = nil, nil
		fl.up, fl.down = false, false
		local _, hum = getChar()
		if hum then hum.PlatformStand = false end
	end,

	step = function(dt)
		local c, hum, hrp = getChar()
		if not (hum and hrp) then return end
		local m, v = STATE.fly.method, STATE.fly.value
		local d = flyDir(hum)
		if m == 1 then
			if fl.lv and fl.lv.Parent then
				fl.lv.VectorVelocity = d * v
				fl.ao.CFrame = face(hrp.Position)
			end
		elseif m == 2 then
			hrp.CFrame = face(hrp.Position + d * v * dt)
			hrp.AssemblyLinearVelocity = Vector3.zero
		elseif m == 3 then
			hrp.AssemblyLinearVelocity = d * v
			hrp.CFrame = face(hrp.Position)
		end
	end,
}

----------------------------------------------------------------------
-- NOCLIP
----------------------------------------------------------------------
local nc = { orig = {}, moved = {} }

local function ncApply(m)
	local c = lp.Character
	if not c then return end
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then
			if not nc.orig[p] then nc.orig[p] = { p.CanCollide, p.CanTouch } end
			if p.CanCollide then p.CanCollide = false end
			if m == 3 and p.CanTouch then p.CanTouch = false end
		end
	end
end

-- Destroyer: parts near you go to ReplicatedStorage, and come back to their old parent when you are far
local function ncRestore(p, info)
	pcall(function()
		local parent = info.parent
		if parent and parent:IsDescendantOf(game) then p.Parent = parent else p.Parent = workspace end
	end)
end

local function topY(p)
	local cf, sz = p.CFrame, p.Size
	return p.Position.Y
		+ math.abs(cf.RightVector.Y) * sz.X / 2
		+ math.abs(cf.UpVector.Y) * sz.Y / 2
		+ math.abs(cf.LookVector.Y) * sz.Z / 2
end

local function destroyerStep()
	local c, hum, hrp = getChar()
	if not (hum and hrp) then return end
	local r = STATE.noclip.value
	if r <= 0 then r = 8 end
	local pos = hrp.Position
	local feetY = pos.Y - 3 -- approx. height of the soles of your feet

	for p, info in pairs(nc.moved) do
		if not p.Parent then
			nc.moved[p] = nil
		elseif (p.Position - pos).Magnitude > r + p.Size.Magnitude / 2 + 4 then
			ncRestore(p, info)
			nc.moved[p] = nil
		end
	end

	local ex = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then table.insert(ex, pl.Character) end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ex
	params.MaxParts = 200

	-- whatever is directly under you is protected, whatever its height
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = ex
	local protected = {}
	for _, off in ipairs({ Vector3.new(0, 0, 0), Vector3.new(2, 0, 0), Vector3.new(-2, 0, 0), Vector3.new(0, 0, 2), Vector3.new(0, 0, -2) }) do
		local hit = workspace:Raycast(pos + off, Vector3.new(0, -10, 0), rp)
		if hit and hit.Instance then protected[hit.Instance] = true end
	end

	for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, r, params)) do
		if not p:IsA("Terrain") and not nc.moved[p] and not protected[p] and topY(p) > feetY + 1.5 then
			local model = p:FindFirstAncestorOfClass("Model")
			if not (model and model:FindFirstChildOfClass("Humanoid")) then
				nc.moved[p] = { parent = p.Parent }
				p.Parent = ReplicatedStorage
			end
		end
	end
end

F.noclip = {
	start = function()
		local m = STATE.noclip.method
		if m == 1 or m == 3 then
			track("noclip", RunService.Stepped:Connect(function()
				ncApply(STATE.noclip.method)
			end))
		elseif m == 4 then
			local _, _, hrp = getChar()
			if not hrp then return end
			nc.hrp, nc.anch = hrp, hrp.Anchored
			hrp.Anchored = true
		end
	end,

	stop = function()
		cleanup("noclip")
		for p, o in pairs(nc.orig) do
			pcall(function()
				if p and p.Parent then
					p.CanCollide = o[1]
					p.CanTouch = o[2]
				end
			end)
		end
		nc.orig = {}
		for p, info in pairs(nc.moved) do ncRestore(p, info) end
		nc.moved = {}
		if nc.hrp then
			pcall(function() nc.hrp.Anchored = nc.anch or false end)
			nc.hrp, nc.anch = nil, nil
		end
		fl.up, fl.down = false, false
	end,

	step = function(dt)
		local m = STATE.noclip.method
		if m == 2 then destroyerStep() return end
		if m ~= 4 then return end
		local _, hum, hrp = getChar()
		if not (hum and hrp) then return end
		local v = STATE.noclip.value
		local d = hum.MoveDirection + Vector3.new(0, (fl.up and 1 or 0) - (fl.down and 1 or 0), 0)
		if d.Magnitude > 1 then d = d.Unit end
		if d.Magnitude > 0 then hrp.CFrame = hrp.CFrame + d * v * dt end
	end,
}

----------------------------------------------------------------------
-- Main loop / inputs / respawn
----------------------------------------------------------------------
table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	for key, s in pairs(STATE) do
		if s.on then pcall(F[key].step, dt) end
	end
end))

table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.E or i.KeyCode == Enum.KeyCode.Space then fl.up = true
	elseif i.KeyCode == Enum.KeyCode.Q or i.KeyCode == Enum.KeyCode.LeftControl then fl.down = true end
end))
table.insert(conns, UIS.InputEnded:Connect(function(i)
	if i.KeyCode == Enum.KeyCode.E or i.KeyCode == Enum.KeyCode.Space then fl.up = false
	elseif i.KeyCode == Enum.KeyCode.Q or i.KeyCode == Enum.KeyCode.LeftControl then fl.down = false end
end))

table.insert(conns, lp.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid", 10)
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.3)
	for key, s in pairs(STATE) do
		if s.on then
			pcall(F[key].stop)
			pcall(F[key].start)
		end
	end
end))

