		local function hold(text, x, field)
			local b = mk("TextButton", {
				Size = UDim2.new(0, 64, 0, 34), Position = UDim2.new(0, x, 0, 208), BackgroundColor3 = C.btn,
				Text = text, TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 14, BorderSizePixel = 0,
			}, page)
			mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
			b.MouseButton1Down:Connect(function() fl[field] = true end)
			b.MouseButton1Up:Connect(function() fl[field] = false end)
			b.MouseLeave:Connect(function() fl[field] = false end)
			table.insert(holdBtns, b)
		end
		hold("UP", 154, "up")
		hold("DOWN", 222, "down")
	end

	-- UP/DOWN: always shown in Fly; in Noclip only while "Anchored CFrame Walk" is selected AND turned ON
	local function updateExtras()
		if #holdBtns == 0 then return end
		local s = STATE[key]
		local show = (key == "fly") or (s.on and s.method == 4)
		for _, b in ipairs(holdBtns) do b.Visible = show end
		toggle.Size = show and UDim2.new(0, 140, 0, 34) or UDim2.new(1, -16, 0, 34)
		if not show then fl.up, fl.down = false, false end
	end

	local mbtns = {}
	local function select(i)
		local s = STATE[key]
		s.method = i
		for j, b in ipairs(mbtns) do b.BackgroundColor3 = (j == i) and C.accent or C.btn end
		desc.Text = methods[i].desc
		if methods[i].default then
			s.value = methods[i].default
			box.Text = tostring(s.value)
			box.TextEditable = true
		else
			s.value = 0
			box.Text = "-"
			box.TextEditable = false
		end
		if s.on then
			pcall(F[key].stop)
			pcall(F[key].start)
		end
		updateExtras()
	end

	for i, m in ipairs(methods) do
		local b = mk("TextButton", {
			Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = C.btn, Text = m.name, TextColor3 = C.text,
			Font = Enum.Font.Gotham, TextSize = 12, BorderSizePixel = 0, LayoutOrder = i,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, list)
		mk("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
		mk("UIPadding", { PaddingLeft = UDim.new(0, 8) }, b)
		b.MouseButton1Click:Connect(function() select(i) end)
		mbtns[i] = b
	end

	box.FocusLost:Connect(function()
		if not box.TextEditable then return end
		local n = tonumber(box.Text)
		if n then STATE[key].value = n else box.Text = tostring(STATE[key].value) end
	end)

	toggle.MouseButton1Click:Connect(function()
		local s = STATE[key]
		s.on = not s.on
		if s.on then pcall(F[key].start) else pcall(F[key].stop) end
		toggle.Text = s.on and "ON" or "OFF"
		toggle.BackgroundColor3 = s.on and C.on or C.off
		updateExtras()
	end)

	select(1)
end

