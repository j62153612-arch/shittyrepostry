local LIGHT_ALL_PARTS = false
local POINTLIGHT_ALL_MAP_COLOR = "Red_Green_Yellow_White_Blue" -- فقط وقتی LIGHT_ALL_PARTS = true باشد کار می‌کند (روی پارت‌هایی که رنگ لایت خودشان را ندارند)
local SET_LOCK_MAP = true -- بعد از اتمام ساخت، همه پارت‌ها Lock می‌شوند
local GLOBAL_LIGHT_RANGE = 20
local GLOBAL_LIGHT_BRIGHTNESS = 0.011
local DISCO_POINTLIGHTS = false
local DISCO_INTERVAL = 0.5

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local tool
for _, v in ipairs(Player:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end
if not tool then for _, v in ipairs(ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end
if not tool or not tool:FindFirstChild("SyncAPI") then warn("خطا: ابزار F3X پیدا نشد!") return end

local remote = tool.SyncAPI.ServerEndpoint
local ActiveSyncs = 0

local CHUNK_SIZE = 250 -- تعداد پارت‌ها در هر بسته ارسالی به سرور

local function FireMassiveSync(action, dataArray, extraArg)
    if not dataArray or #dataArray == 0 then return end
    
    -- تقسیم کردن آرایه بزرگ به بسته‌های کوچکتر
    for i = 1, #dataArray, CHUNK_SIZE do
        local chunk = {}
        for j = i, math.min(i + CHUNK_SIZE - 1, #dataArray) do
            table.insert(chunk, dataArray[j])
        end
        
        ActiveSyncs = ActiveSyncs + 1
        task.spawn(function()
            pcall(function()
                if extraArg ~= nil then 
                    remote:InvokeServer(action, chunk, extraArg)
                else 
                    remote:InvokeServer(action, chunk) 
                end
            end)
            ActiveSyncs = ActiveSyncs - 1
        end)
        
        task.wait() -- یک مکث بسیار کوتاه تا صف شبکه روبلاکس قفل نشود
    end
end

local function safeNum(val, default) return tonumber(val) or default or 0 end

-- =========================================================
-- [ توابع کمکی خواندن مقادیر از متن اکسپورت ] --
-- %f[%a] باعث می‌شود مثلاً "Color:" داخل "LightColor:" یا "FireColor:" پیدا نشود
-- =========================================================
local function getNumber(block, key)
    local s = block:match("%f[%a]" .. key .. ":%s*(%-?[%d%.]+)")
    return tonumber(s)
end

local function getBoolean(block, key)
    local s = block:match("%f[%a]" .. key .. ":%s*(%a+)")
    if not s then return nil end
    return s:lower() == "true"
end

-- رنگ‌های جدید اکسپورتر به صورت 0 تا 1 ذخیره شده‌اند
local function getColor3(block, key)
    local r, g, b = block:match("%f[%a]" .. key .. ":%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)")
    local rn, gn, bn = tonumber(r), tonumber(g), tonumber(b)
    if rn and gn and bn then
        return Color3.new(math.clamp(rn, 0, 1), math.clamp(gn, 0, 1), math.clamp(bn, 0, 1))
    end
    return nil
end

-- لیست رنگ‌های قابل استفاده برای POINTLIGHT_ALL_MAP_COLOR
local COLOR_MAP = {
    Red = Color3.fromRGB(255, 0, 0),
    Green = Color3.fromRGB(0, 255, 0),
    Yellow = Color3.fromRGB(255, 255, 0),
    White = Color3.fromRGB(255, 255, 255),
    Blue = Color3.fromRGB(0, 0, 255),
    Orange = Color3.fromRGB(255, 128, 0),
    Purple = Color3.fromRGB(150, 0, 255),
    Pink = Color3.fromRGB(255, 105, 180),
    Cyan = Color3.fromRGB(0, 255, 255),
}

local LIGHT_COLORS = {}
for name in string.gmatch(tostring(POINTLIGHT_ALL_MAP_COLOR), "[^_]+") do
    if COLOR_MAP[name] then table.insert(LIGHT_COLORS, COLOR_MAP[name]) end
end
if #LIGHT_COLORS == 0 then LIGHT_COLORS = {Color3.new(1, 1, 1)} end

local function SetFreeze(state)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = state
    end
end

