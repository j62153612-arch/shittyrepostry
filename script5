local function makeScrollSmart(scrollFrame)
    scrollFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            local delta = input.Position.Z * 50
            local newY = math.clamp(scrollFrame.CanvasPosition.Y - delta, 0, math.max(0, scrollFrame.CanvasSize.Y.Offset - scrollFrame.AbsoluteSize.Y))
            scrollFrame.CanvasPosition = Vector2.new(0, newY)
        end
    end)
end

