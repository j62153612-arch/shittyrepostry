local function getObjectPath(obj)
    if not obj then return "nil" end
    if obj == workspace then return "workspace" end
    if obj == game then return "game" end
    
    local current = obj
    local pathParts = {}
    
    while current and current ~= game do
        table.insert(pathParts, 1, current.Name)
        current = current.Parent
    end
    
    if current ~= game then
        return "workspace"
    end
    
    local topChildName = pathParts[1]
    local path = string.format('game:GetService("%s")', topChildName)
    
    for i = 2, #pathParts do
        local partName = pathParts[i]
        if partName:match("^[%a_][%w_]*$") then
            path = path .. "." .. partName
        else
            path = path .. string.format('[%q]', partName)
        end
    end
    
    return path
end

LogButton.MouseButton1Click:Connect(function()
    local sourceCode = InputBox.Text
    if sourceCode == "" then 
        logPages = {"-- Error: Input script is empty!"}
        currentPage = 1
        updatePageDisplay()
        return 
    end

    local rawLogs = {}
    table.insert(rawLogs, "-- Generated by C00LHACK Env Logger")
    table.insert(rawLogs, "local G2L = {}")
    table.insert(rawLogs, "")

    local createdInstances = {}
    local isSpying = false

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        local res = oldNamecall(self, ...)
        
        if isSpying and (method == "HttpGet" or method == "HttpGetAsync" or method == "HttpPost" or method == "HttpPostAsync") then
            local url = tostring(args[1])
            if type(res) == "string" and res ~= "" then
                task.spawn(function()
                    table.insert(rawLogs, "-- [Decoded Script from: " .. url .. "]")
                    table.insert(rawLogs, res)
                end)
            end
        end
        
        return res
    end
    setreadonly(mt, true)

    local gameProxy = {}
    setmetatable(gameProxy, {
        __index = function(_, k)
            local val = game[k]
            if typeof(val) == "function" then
                if k == "HttpGet" or k == "HttpGetAsync" or k == "HttpPost" or k == "HttpPostAsync" then
                    return function(self, url, ...)
                        local res = val(game, url, ...)
                        if isSpying and url and type(res) == "string" and res ~= "" then
                            task.spawn(function()
                                table.insert(rawLogs, "-- [Decoded Script from: " .. tostring(url) .. "]")
                                table.insert(rawLogs, res)
                            end)
                        end
                        return res
                    end
                elseif k == "GetService" then
                    return function(_, sName)
                        local service = game:GetService(sName)
                        if sName == "HttpService" then
                            local sProxy = {}
                            setmetatable(sProxy, {
                                __index = function(_, sk)
                                    local sVal = service[sk]
                                    if typeof(sVal) == "function" and (sk == "GetAsync" or sk == "PostAsync" or sk == "RequestAsync") then
                                        return function(sSelf, url, ...)
                                            local res = sVal(service, url, ...)
                                            if isSpying and url then
                                                task.spawn(function()
                                                    local body = ""
                                                    if type(res) == "string" then
                                                        body = res
                                                    elseif type(res) == "table" and res.Body then
                                                        body = res.Body
                                                    end
                                                    if body ~= "" then
                                                        table.insert(rawLogs, "-- [Decoded Script from HttpService: " .. tostring(url) .. "]")
                                                        table.insert(rawLogs, body)
                                                    end
                                                end)
                                            end
                                            return res
                                        end
                                    end
                                    return sVal
                                end
                            })
                            return sProxy
                        end
                        return service
                    end
                end
                return function(_, ...)
                    return val(game, ...)
                end
            end
            return val
        end
    })

    local customEnv = {}
    setmetatable(customEnv, {
        __index = function(_, k)
            if k == "print" then
                return function(...)
                    local args = {...}
                    local formatted = {}
                    for _, v in ipairs(args) do table.insert(formatted, tostring(v)) end
                    local str = table.concat(formatted, "\t")
                    table.insert(rawLogs, string.format('print(%q)', str))
                end
            elseif k == "warn" then
                return function(...)
                    local args = {...}
                    local formatted = {}
                    for _, v in ipairs(args) do table.insert(formatted, tostring(v)) end
                    local str = table.concat(formatted, "\t")
                    table.insert(rawLogs, string.format('warn(%q)', str))
                end
            elseif k == "game" then
                return gameProxy
            elseif k == "loadstring" then
                local realLoadstring = getfenv().loadstring
                return function(code, chunkname)
                    if isSpying and type(code) == "string" and code ~= "" then
                        table.insert(rawLogs, "-- [Decoded Loadstring Code]")
                        table.insert(rawLogs, code)
                    end
                    if realLoadstring then
                        return realLoadstring(code, chunkname)
                    end
                    return nil
                end
            elseif k == "request" or k == "http_request" then
                local realReq = getfenv()[k]
                if not realReq then return nil end
                return function(options)
                    local res = realReq(options)
                    if isSpying and type(options) == "table" and options.Url then
                        task.spawn(function()
                            local body = ""
                            if type(res) == "table" and res.Body then
                                body = res.Body
                            elseif type(res) == "string" then
                                body = res
                            end
                            if body ~= "" then
                                table.insert(rawLogs, "-- [Decoded Script from Request: " .. tostring(options.Url) .. "]")
                                table.insert(rawLogs, body)
                            end
                        end)
                    end
                    return res
                end
            elseif k == "Instance" then
                local realInstance = getfenv().Instance
                local proxyInstance = {}
                for ik, iv in pairs(realInstance) do proxyInstance[ik] = iv end
                
                proxyInstance.new = function(className, parent)
                    local obj = realInstance.new(className, parent)
                    table.insert(createdInstances, obj)
                    return obj
                end
                return proxyInstance
            else
                return getfenv()[k]
            end
        end
    })

    local fn, loadErr = loadstring(sourceCode)
    if not fn then
        logPages = {"-- Compilation Error:\n" .. tostring(loadErr)}
        currentPage = 1
        updatePageDisplay()
        return
    end

    setfenv(fn, customEnv)

    isSpying = true
    local success, runErr = pcall(fn)
    isSpying = false

    task.wait(0.2)

    setreadonly(mt, false)
    mt.__namecall = oldNamecall
    setreadonly(mt, true)

    if not success then
        table.insert(rawLogs, "-- Runtime Error encountered: " .. tostring(runErr))
    end

    local g2lMap = {}
    local counter = 0
    local mainFrameVar = nil

    for _, obj in ipairs(createdInstances) do
        if obj and obj.Parent then
            counter = counter + 1
            local varName = string.format("G2L[%d]", counter)
            g2lMap[obj] = varName
            
            table.insert(rawLogs, string.format('%s = Instance.new("%s")', varName, obj.ClassName))
            
            if obj:IsA("Frame") and not mainFrameVar then
                local parentObj = obj.Parent
                local isParentFrame = parentObj and parentObj:IsA("Frame")
                if not isParentFrame then
                    mainFrameVar = varName
                end
            end
        end
    end

    table.insert(rawLogs, "")
    table.insert(rawLogs, "-- Properties & Final State Setup")

    for _, obj in ipairs(createdInstances) do
        local varName = g2lMap[obj]
        if varName then
            pcall(function()
                table.insert(rawLogs, string.format('%s.Name = %q', varName, obj.Name))
                
                if obj.Parent and g2lMap[obj.Parent] then
                    table.insert(rawLogs, string.format('%s.Parent = %s', varName, g2lMap[obj.Parent]))
                elseif obj.Parent then
                    table.insert(rawLogs, string.format('%s.Parent = %s', varName, getObjectPath(obj.Parent)))
                end
                
                if obj:IsA("BasePart") then
                    table.insert(rawLogs, string.format('%s.Size = Vector3.new(%.3f, %.3f, %.3f)', varName, obj.Size.X, obj.Size.Y, obj.Size.Z))
                    table.insert(rawLogs, string.format('%s.Position = Vector3.new(%.3f, %.3f, %.3f)', varName, obj.Position.X, obj.Position.Y, obj.Position.Z))
                    table.insert(rawLogs, string.format('%s.Color = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.Color.R*255), math.floor(obj.Color.G*255), math.floor(obj.Color.B*255)))
                    table.insert(rawLogs, string.format('%s.Transparency = %.2f', varName, obj.Transparency))
                    table.insert(rawLogs, string.format('%s.Anchored = %s', varName, tostring(obj.Anchored)))
                    table.insert(rawLogs, string.format('%s.CanCollide = %s', varName, tostring(obj.CanCollide)))
                elseif obj:IsA("GuiObject") then
                    if varName == mainFrameVar then
                        table.insert(rawLogs, string.format('%s.Size = UDim2.new(%.3f, %d, %.3f, %d)', varName, obj.Size.X.Scale, obj.Size.X.Offset, obj.Size.Y.Scale, obj.Size.Y.Offset))
                        table.insert(rawLogs, string.format('%s.Position = UDim2.new(0.5, -%d, 0.5, -%d)', varName, math.floor(obj.AbsoluteSize.X / 2), math.floor(obj.AbsoluteSize.Y / 2)))
                    else
                        table.insert(rawLogs, string.format('%s.Size = UDim2.new(%.3f, %d, %.3f, %d)', varName, obj.Size.X.Scale, obj.Size.X.Offset, obj.Size.Y.Scale, obj.Size.Y.Offset))
                        table.insert(rawLogs, string.format('%s.Position = UDim2.new(%.3f, %d, %.3f, %d)', varName, obj.Position.X.Scale, obj.Position.X.Offset, obj.Position.Y.Scale, obj.Position.Y.Offset))
                    end
                    
                    table.insert(rawLogs, string.format('%s.AnchorPoint = Vector2.new(%.2f, %.2f)', varName, obj.AnchorPoint.X, obj.AnchorPoint.Y))
                    table.insert(rawLogs, string.format('%s.BackgroundColor3 = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.BackgroundColor3.R*255), math.floor(obj.BackgroundColor3.G*255), math.floor(obj.BackgroundColor3.B*255)))
                    table.insert(rawLogs, string.format('%s.BackgroundTransparency = %.2f', varName, obj.BackgroundTransparency))
                    table.insert(rawLogs, string.format('%s.BorderSizePixel = %d', varName, obj.BorderSizePixel))
                    table.insert(rawLogs, string.format('%s.BorderColor3 = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.BorderColor3.R*255), math.floor(obj.BorderColor3.G*255), math.floor(obj.BorderColor3.B*255)))
                    table.insert(rawLogs, string.format('%s.Visible = %s', varName, tostring(obj.Visible)))
                    table.insert(rawLogs, string.format('%s.ZIndex = %d', varName, obj.ZIndex))
                    table.insert(rawLogs, string.format('%s.LayoutOrder = %d', varName, obj.LayoutOrder))
                    table.insert(rawLogs, string.format('%s.ClipsDescendants = %s', varName, tostring(obj.ClipsDescendants)))
                    table.insert(rawLogs, string.format('%s.Active = %s', varName, tostring(obj.Active)))
                    table.insert(rawLogs, string.format('%s.Rotation = %.2f', varName, obj.Rotation))
                    
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        table.insert(rawLogs, string.format('%s.Text = %q', varName, obj.Text))
                        table.insert(rawLogs, string.format('%s.TextColor3 = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.TextColor3.R*255), math.floor(obj.TextColor3.G*255), math.floor(obj.TextColor3.B*255)))
                        table.insert(rawLogs, string.format('%s.TextSize = %d', varName, obj.TextSize))
                        table.insert(rawLogs, string.format('%s.TextScaled = %s', varName, tostring(obj.TextScaled)))
                        table.insert(rawLogs, string.format('%s.TextWrapped = %s', varName, tostring(obj.TextWrapped)))
                        table.insert(rawLogs, string.format('%s.RichText = %s', varName, tostring(obj.RichText)))
                        table.insert(rawLogs, string.format('%s.TextXAlignment = Enum.TextXAlignment.%s', varName, tostring(obj.TextXAlignment):match("%.([^%.]+)$") or "Left"))
                        table.insert(rawLogs, string.format('%s.TextYAlignment = Enum.TextYAlignment.%s', varName, tostring(obj.TextYAlignment):match("%.([^%.]+)$") or "Center"))
                        pcall(function()
                            table.insert(rawLogs, string.format('%s.FontFace = Font.new(%q)', varName, obj.FontFace.Family))
                        end)
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        table.insert(rawLogs, string.format('%s.Image = %q', varName, obj.Image))
                        table.insert(rawLogs, string.format('%s.ImageColor3 = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.ImageColor3.R*255), math.floor(obj.ImageColor3.G*255), math.floor(obj.ImageColor3.B*255)))
                        table.insert(rawLogs, string.format('%s.ImageTransparency = %.2f', varName, obj.ImageTransparency))
                    elseif obj:IsA("ScrollingFrame") then
                        table.insert(rawLogs, string.format('%s.CanvasSize = UDim2.new(%.3f, %d, %.3f, %d)', varName, obj.CanvasSize.X.Scale, obj.CanvasSize.X.Offset, obj.CanvasSize.Y.Scale, obj.CanvasSize.Y.Offset))
                        table.insert(rawLogs, string.format('%s.ScrollBarThickness = %d', varName, obj.ScrollBarThickness))
                    end
                elseif obj:IsA("ScreenGui") then
                    table.insert(rawLogs, string.format('%s.ResetOnSpawn = %s', varName, tostring(obj.ResetOnSpawn)))
                    table.insert(rawLogs, string.format('%s.ZIndexBehavior = Enum.ZIndexBehavior.%s', varName, tostring(obj.ZIndexBehavior):match("%.([^%.]+)$") or "Sibling"))
                    table.insert(rawLogs, string.format('%s.IgnoreGuiInset = %s', varName, tostring(obj.IgnoreGuiInset)))
                elseif obj:IsA("UICorner") then
                    table.insert(rawLogs, string.format('%s.CornerRadius = UDim.new(%.3f, %d)', varName, obj.CornerRadius.Scale, obj.CornerRadius.Offset))
                elseif obj:IsA("UIStroke") then
                    table.insert(rawLogs, string.format('%s.Thickness = %.1f', varName, obj.Thickness))
                    table.insert(rawLogs, string.format('%s.Color = Color3.fromRGB(%d, %d, %d)', varName, math.floor(obj.Color.R*255), math.floor(obj.Color.G*255), math.floor(obj.Color.B*255)))
                    table.insert(rawLogs, string.format('%s.Transparency = %.2f', varName, obj.Transparency))
                end
            end)
        end
    end

    if mainFrameVar then
        table.insert(rawLogs, "")
        table.insert(rawLogs, "-- Standard Drag System")
        table.insert(rawLogs, string.format([[
local _UIS = game:GetService("UserInputService")
local _dragging, _dragInput, _dragStart, _startPos
local _targetFrame = %s

_targetFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        _dragging = true
        _dragStart = input.Position
        _startPos = _targetFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                _dragging = false
            end
        end)
    end
end)

_targetFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        _dragInput = input
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if _dragging and _dragInput then
        local delta = _dragInput.Position - _dragStart
        _targetFrame.Position = UDim2.new(_startPos.X.Scale, _startPos.X.Offset + delta.X, _startPos.Y.Scale, _startPos.Y.Offset + delta.Y)
    end
end)
]], mainFrameVar))
    end

    logPages = {}
    local chunkSize = 60
    local currentChunk = {}
    
    for _, line in ipairs(rawLogs) do
        table.insert(currentChunk, line)
        if #currentChunk >= chunkSize then
            table.insert(logPages, table.concat(currentChunk, "\n"))
            currentChunk = {}
        end
    end
    
    if #currentChunk > 0 then
        table.insert(logPages, table.concat(currentChunk, "\n"))
    end

    currentPage = 1
    updatePageDisplay()
end)

