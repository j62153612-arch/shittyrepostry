-- Logic
---------------------------------------------------------------------
local function getTargets()
	local list = {}
	local ok, island = pcall(function() return workspace:FindFirstChild("HarborGardenIsland") end)
	if not ok or not island then return list end

	local function add(folderName, partName)
		local folder = island:FindFirstChild(folderName)
		local part = folder and folder:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			table.insert(list, part)
		end
	end

	add("GrappleObby", "swap part26")
	add("IranTowerObby", "swap part2")
	add("IranTowerObby", "swap part")
	return list
end

local busy = false

local function setButton(text)
	if button and button.Parent then button.Text = text end
end

button.MouseButton1Click:Connect(function()
	if busy then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	busy = true
	setButton("Running...")

	local originalCFrame = hrp.CFrame
	local oldSubject = camera.CameraSubject
	local oldType = camera.CameraType
	local camPart
	local targets = getTargets()
	local saved = {}

	local function restore()
		-- ۱) برگشت به جای اول، صفر کردن سرعت و آزاد کردن کاراکتر
		if hrp and hrp.Parent then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.CFrame = originalCFrame
		end
		-- ۲) حذف پارت
		if camPart then camPart:Destroy() end
		-- برگرداندن دوربین
		camera.CameraSubject = (oldSubject and oldSubject.Parent) and oldSubject or hum
		camera.CameraType = oldType
		-- برگرداندن ویژگی‌ها
		for part, props in pairs(saved) do
			if part and part.Parent then
				part.CanTouch = props.CanTouch
				part.CanCollide = props.CanCollide
				part.CanQuery = props.CanQuery
			end
		end
	end

	local ok, err = pcall(function()
		-- 1) پارت کلاینت‌ساید در وسط HumanoidRootPart
		camPart = Instance.new("Part")
		camPart.Name = "ClientCamPart"
		camPart.Size = Vector3.new(4, 1, 4)
		camPart.Transparency = 0.5
		camPart.CanCollide = false
		camPart.CanTouch = false
		camPart.CanQuery = false
        camPart.Anchored = true
		camPart.CFrame = hrp.CFrame
		camPart.Parent = workspace

		-- 2) دوربین روی پارت
		camera.CameraSubject = camPart

		-- 3) غیرفعال کردن CanTouch / CanCollide / CanQuery
		for _, p in ipairs(targets) do
			saved[p] = {CanTouch = p.CanTouch, CanCollide = p.CanCollide, CanQuery = p.CanQuery}
			p.CanTouch = false
			p.CanCollide = false
			p.CanQuery = false
		end

		-- 4) تلپورت به ترتیب به هرکدام
		-- HumanoidRootPart حین عملیات Anchored است تا نیفتیم (CanCollide پارت‌ها خاموش است)
		for _, p in ipairs(targets) do
			if not hrp.Parent then error("character removed") end
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.CFrame = p.CFrame * CFrame.new(0, 3, 0)
			task.wait(TELEPORT_DELAY)
		end

		-- 5) برگشت به جای اول در همان لحظه (بدون مکث اضافه) توسط restore() انجام می‌شود
	end)

	-- 6) در هر حالت (حتی خطا) همه چیز برمی‌گردد
	restore()

	if not ok then warn("[RunScriptPanel]", err) end
	setButton("Run Script")
	busy = false
end)
