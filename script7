local viewport = gui.AbsoluteSize
local targetPos = Vector2.new(viewport.X / 2, viewport.Y / 2)
local currentPos = targetPos
root.Position = UDim2.fromOffset(currentPos.X, currentPos.Y)

local dragging = false
local dragStartInput, dragStartTarget

local function clampToScreen(v)
	local vs = gui.AbsoluteSize
	local halfW, halfH = root.AbsoluteSize.X / 2, root.AbsoluteSize.Y / 2
	return Vector2.new(
		math.clamp(v.X, halfW, math.max(halfW, vs.X - halfW)),
		math.clamp(v.Y, halfH, math.max(halfH, vs.Y - halfH))
	)
end

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStartInput = input.Position
		dragStartTarget = targetPos
		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				conn:Disconnect()
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = Vector2.new(input.Position.X - dragStartInput.X, input.Position.Y - dragStartInput.Y)
		targetPos = clampToScreen(dragStartTarget + delta)
	end
end)

-- Lerp هر فریم؛ مستقل از FPS و بدون لرزش
local dragConn = RunService.RenderStepped:Connect(function(dt)
	local alpha = 1 - math.exp(-22 * dt)
	currentPos = currentPos:Lerp(targetPos, alpha)
	root.Position = UDim2.fromOffset(math.floor(currentPos.X + 0.5), math.floor(currentPos.Y + 0.5))
end)

