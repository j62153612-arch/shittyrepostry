local function rgbHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

local function escapeRichText(text)
    local s = tostring(text)
    s = s:gsub("&", "&")
    s = s:gsub("<", "<")
    s = s:gsub(">", ">")
    s = s:gsub('"', [["]])
    return s
end

