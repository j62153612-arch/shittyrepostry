local function emit(level, message, details)
    if type(GuiLogLines) ~= "table" then
        GuiLogLines = {}
    end

    level = string.upper(level or "INFO")
    local timeText = os.date("%H:%M:%S")
    local color = Palette[level] or Palette.INFO

    local row = Instance.new("TextLabel")
    row.Size = UDim2.new(1, -8, 0, 16)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1
    row.RichText = true
    row.TextWrapped = true
    row.TextSize = 12
    row.TextColor3 = Color3.fromRGB(80, 255, 130)
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.Text = string.format(
        '<font color="#009944">[%s]</font> <font color="%s">[%s]</font> %s%s',
        timeText, rgbHex(color), escapeRichText(level), escapeRichText(message),
        details and (' <font color="#44CC77">| ' .. escapeRichText(details) .. "</font>") or ""
    )
    row.Parent = Scroll

    table.insert(GuiLogLines, row)
    if #GuiLogLines > 400 then
        local old = table.remove(GuiLogLines, 1)
        if old then old:Destroy() end
    end

    task.defer(function()
        if Scroll and Layout then
            Scroll.CanvasPosition = Vector2.new(0, math.max(0, Layout.AbsoluteContentSize.Y - Scroll.AbsoluteWindowSize.Y))
        end
    end)
end

local function identifyKind(obj)
    if obj:IsA("RemoteEvent") then return "RemoteEvent", true, "event" end
    if obj:IsA("RemoteFunction") then return "RemoteFunction", true, "function" end
    if obj.ClassName == "UnreliableRemoteEvent" then return "UnreliableRemoteEvent", true, "event" end
    return nil, false, nil
end

local function isDefaultRobloxRemote(record)
    local path = record.path:lower()
    local name = record.name:lower()
    if path:find("replicatedstorage") and (name:find("default") or name:find("rbx") or name:find("system")) then return true end
    if path:find("starterplayer") or path:find("coregui") then return true end
    return false
end

local function isRisky(remote)
    if not remote or not remote.name then return false end
    local n = remote.name:lower()
    local risky = {
        "kick", "ban", "teleport", "admin", "rank", "execute", "command", "crash",
        "punish", "moderator", "anticheat", "report", "banish", "flag", "detect",
        "security", "validate", "auth", "hdadmin", "currentcall", "updatecurrent",
        "playtest", "update", "claim", "getserverchannel", "syncdata", "getsync", "data"
    }
    for _, word in ipairs(risky) do
        if n:find(word) then return true end
    end
    return false
end

local function isCurrencyRemote(name)
    local n = name:lower()
    return n:find("cash") or n:find("money") or n:find("coin") or n:find("currency") or n:find("balance")
end

