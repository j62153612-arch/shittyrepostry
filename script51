local function printVortyxExploitReport()
    emit("Vortyx", "=== FULL EXPLOIT REPORT ===", #State.Findings .. " findings")
    for i, f in ipairs(State.Findings) do
        emit("Vortyx", string.format("#%02d [%s] %s", i, f.severity, f.remote.name), f.remote.path)
        emit("INFO", "Abuse", f.abuse)
        emit("INFO", "Evidence", f.evidence)
        emit("SYSTEM", f.exploitScript, "")
        print("\n" .. f.exploitScript)
    end
end

local function getPlayerCurrency()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, v in ipairs(leaderstats:GetChildren()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue")) and
               (v.Name:lower():find("cash") or v.Name:lower():find("money") or v.Name:lower():find("coin")) then
                return v, v.Value
            end
        end
    end
    return nil, 0
end

local function testCurrencyRemote(remoteRecord)
    local currencyObj, before = getPlayerCurrency()
    if not currencyObj then return false end

    pcall(function()
        if remoteRecord.mode == "event" then
            remoteRecord.instance:FireServer("Money", 999999999)
        else
            remoteRecord.instance:InvokeServer("Money", 999999999)
        end
    end)
    task.wait(0.8)
    local _, after = getPlayerCurrency()

    if after > before then
        emit("SUCCESS", "REAL DUPE DETECTED!", remoteRecord.name .. " (+" .. (after - before) .. ")")
        return true
    end
    return false
end

local function scanObjects()
    State.remotes = {}
    State.Findings = {}
    resetCounters()
    emit("SCAN", "Starting Deep Scan - Player Remotes", "")
    print("=== FINDER SCAN START ===")

    for _, obj in ipairs(game:GetDescendants()) do
        if not State.running and TestBtn.Text == "..." then break end
        local class, isNetwork, mode = identifyKind(obj)
        if class and isNetwork then
            local record = {
                instance = obj,
                name = obj.Name,
                path = obj:GetFullName(),
                class = class,
                isNetwork = isNetwork,
                mode = mode
            }
            if not isDefaultRobloxRemote(record) then
                table.insert(State.remotes, record)
                State.counters.discovered += 1

                local logMsg = string.format("[%s] %s | %s", class, record.name, record.path)
                emit("DISCOVERED", class, record.name .. " | " .. record.path)
                print(logMsg)
            end
        end
    end

    emit("COMPLETE", "Scan Finished", State.counters.discovered .. " player remotes")
    print("=== SCAN COMPLETE - Found " .. State.counters.discovered .. " player remotes ===")
end

autoTestExploitFindings = function()
    if #State.Findings == 0 then
        emit("WARN", "No findings to auto-test", "")
        return
    end

    emit("Vortyx", "=== AUTO TESTING EXPLOIT FINDINGS ===", #State.Findings .. " targets")
    for i, finding in ipairs(State.Findings) do
        emit("TEST", string.format("Auto-Testing Finding #%02d", i), finding.remote.name)

        local payloadsToTry = {
            {"Money", 999999999},
            {"Give", "Gun"},
            {"Give", "Money", 999999999, LocalPlayer}
        }

        for _, args in ipairs(payloadsToTry) do
            task.spawn(function()
                local ok, result = pcall(function()
                    if finding.remote.mode == "event" then
                        finding.remote.instance:FireServer(table.unpack(args))
                        return "SENT"
                    else
                        return finding.remote.instance:InvokeServer(table.unpack(args))
                    end
                end)

                if ok then
                    emit("RETURNED", "Auto-Exploit Test: " .. tostring(result), finding.remote.name)
                else
                    emit("ERROR", "Auto-Exploit Test Failed", finding.remote.name)
                end
            end)
            task.wait(State.delay + 0.05)
        end
    end
    emit("COMPLETE", "Auto Exploit Testing Finished", "")
end

local function runAuthorizedTests()
    if State.running then
        emit("WARN", "Already running")
        return
    end

    State.running = true
    TestBtn.Text = "..."
    local total = 0

    scanObjects()
    emit("Vortyx", "=== ROBUST TESTING STARTED (AUTO EXPLOIT ON) ===")

    task.spawn(function()
        for i, remoteRecord in ipairs(State.remotes) do
            if not State.running then break end
            if not remoteRecord.isNetwork then continue end

            local nameLower = remoteRecord.name:lower()
            local skip = State.skipRisky and isRisky(remoteRecord) or
                (State.categorySkips.voice and nameLower:find("voice")) or
                (State.categorySkips.admin and nameLower:find("admin")) or
                (State.categorySkips.teleport and nameLower:find("teleport")) or
                (State.categorySkips.update and (nameLower:find("update") or nameLower:find("currentcall"))) or
                (State.categorySkips.purchase and (nameLower:find("purchase") or nameLower:find("buy"))) or
                (State.categorySkips.damage and nameLower:find("damage")) or
                (State.categorySkips.currency and isCurrencyRemote(remoteRecord.name)) or
                (State.categorySkips.chat and nameLower:find("chat")) or
                (State.categorySkips.gamepass and nameLower:find("gamepass")) or
                (State.categorySkips.devproduct and (nameLower:find("devproduct") or nameLower:find("product"))) or
                (State.categorySkips.shop and (nameLower:find("shop") or nameLower:find("buy"))) or
                (State.categorySkips.reward and nameLower:find("reward")) or
                (State.categorySkips.quest and nameLower:find("quest")) or
                (State.categorySkips.leaderstat and nameLower:find("leaderstat")) or
                (State.categorySkips.inventory and (nameLower:find("recycle") or nameLower:find("sell") or nameLower:find("delete"))) or
                nameLower:find("data") or nameLower:find("sync")

            if skip then
                State.counters.skipped += 1
                emit("SKIPPED", "Skipped", remoteRecord.name)
                continue
            end

            emit("QUEUED", string.format("Testing %d / %d", i, #State.remotes), remoteRecord.name)

            local acceptedBad = false

            for _, payload in ipairs(TestPayloads) do
                if not State.running then break end
                total += 1
                emit("TEST", string.format("Firing %s | %s", remoteRecord.name, payload.name), "")

                task.spawn(function()
                    local ok, result = pcall(function()
                        if remoteRecord.mode == "event" then
                            remoteRecord.instance:FireServer(table.unpack(payload.args or {}))
                            return "SENT"
                        else
                            return remoteRecord.instance:InvokeServer(table.unpack(payload.args or {}))
                        end
                    end)

                    if ok then
                        if remoteRecord.mode == "event" then
                            State.counters.sent += 1
                        else
                            State.counters.returned += 1
                            emit("RETURNED", "Returned: " .. tostring(result), remoteRecord.name)
                            if type(result) == "boolean" and result == true then
                                acceptedBad = true
                            end
                        end
                    else
                        State.counters.errors += 1
                        emit("ERROR", "Failed", remoteRecord.name)
                    end
                end)

                task.wait(State.delay)
            end

            if isCurrencyRemote(remoteRecord.name) then
                if testCurrencyRemote(remoteRecord) then
                    addFinding(remoteRecord, "Critical", "REAL Currency Dupe", "Money increased after firing")
                else
                    addFinding(remoteRecord, "High", "Currency Remote", "Detected but no increase")
                end
            elseif acceptedBad then
                addFinding(remoteRecord, "Critical", "Epic Remote", "Accepted bad input")
            end

            task.wait(0.1)
        end

        State.running = false
        TestBtn.Text = "Scan"
        emit("COMPLETE", "Testing Finished", total .. " requests")
        task.wait(0.5)
        printVortyxExploitReport()

        if State.autoTestFindings and #State.Findings > 0 then
            autoTestExploitFindings()
        end
    end)
end

