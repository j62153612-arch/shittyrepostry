local function scramble(str, amount)
	local out = {}
	for i = 1, #str do
		local ch = str:sub(i, i)
		if ch ~= " " and rng:NextNumber() < amount then
			out[i] = GLITCH_CHARS[rng:NextInteger(1, #GLITCH_CHARS)]
		else
			out[i] = ch
		end
	end
	return table.concat(out)
end

