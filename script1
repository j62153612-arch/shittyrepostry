local CYL_COUNT = 8
local CYL_SPACING = 5 -- studs between cylinders (8 * 5 = ~40 studs ahead)
local CYL_DELAY = 0.06 -- seconds between cylinders (sequential eruption)
local RISE_STEPS = 4 -- fewer steps = faster rise
local RISE_STEP_WAIT = 0.015
local PARK_DEPTH = 80 -- how deep under the map the spare cylinders wait
local HIDE_MARGIN = 4 -- extra studs below the ground before rising (raise it if any part still shows)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = {char}

local function groundY(pos)
	local hit = workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -200, 0), rayParams)
	return hit and hit.Position.Y or (pos.Y - 3)
end

-- sequential sizes: each cylinder is a bit taller/wider than the last
local function cylSize(k)
	return 10 + k * 3, 4 + k * 0.8
end

-- Builds a full batch of ready-to-go cylinders (size, Neon, color, PointLight,
-- anchored, no collision) parked deep under the map, so a click only has to move them.
local function buildPool()
	local pool = {}
	local pending = CYL_COUNT
	local rp = root.Position
	local gy = groundY(rp)

	for k = 1, CYL_COUNT do
		task.spawn(function()
			local height, diameter = cylSize(k)
			local park = CF(rp.X + k * 6, gy - PARK_DEPTH, rp.Z) * ANG(0, 0, rad(90))
			local part = call("CreatePart", "Cylinder", park, workspace)
			if part then
				pool[k] = {part = part, k = k, height = height, diameter = diameter, park = park}
			end
			pending -= 1
		end)
	end
	while pending > 0 do
		task.wait()
	end

	local resize, anchor, collide, material, colors, createL, syncL = {}, {}, {}, {}, {}, {}, {}
	for k = 1, CYL_COUNT do
		local c = pool[k]
		if c then
			local color = Color3.fromHSV((k - 1) / CYL_COUNT, 1, 1)
			table.insert(resize, {Part = c.part, CFrame = c.park, Size = Vector3.new(c.height, c.diameter, c.diameter)})
			table.insert(anchor, {Part = c.part, Anchored = true})
			table.insert(collide, {Part = c.part, CanCollide = false})
			-- Material tool: Neon + 0.5 transparency (beam-of-light look)
			table.insert(material, {Part = c.part, Material = Enum.Material.Neon, Transparency = 0.5})
			table.insert(colors, {Part = c.part, Color = color, UnionColor = true})
			table.insert(createL, {Part = c.part, LightType = "PointLight"})
			table.insert(syncL, {Part = c.part, LightType = "PointLight", Color = LIGHT_COLOR, Brightness = 2, Range = 14})
		end
	end
	call("SyncResize", resize)
	call("SyncAnchor", anchor)
	call("SyncCollision", collide)
	call("SyncMaterial", material)
	call("SyncColor", colors)
	call("CreateLights", createL)
	call("SyncLighting", syncL)

	return pool
end

local readyPool = nil -- the prepared batch waiting under the map

local function cleanupPool()
	if readyPool then
		local list = {}
		for k = 1, CYL_COUNT do
			if readyPool[k] then
				table.insert(list, readyPool[k].part)
			end
		end
		readyPool = nil
		call("Remove", list)
	end
end

local function refillPool()
	readyPool = buildPool()
	if stopped then
		cleanupPool()
	end
end

hum.Died:Connect(cleanupPool)
player.CharacterRemoving:Connect(cleanupPool)

-- prepare the first batch right away
task.spawn(refillPool)

-- Hit detection: any other player's character touching a rising cylinder
-- gets its Head removed through F3X ("Remove"), which kills them.
local hitModels = {}
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.FilterDescendantsInstances = {char}

local function checkHits(part)
	local ok, found = pcall(function()
		return workspace:GetPartsInPart(part, overlapParams)
	end)
	if not ok then
		return
	end
	for _, p in ipairs(found) do
		local model = p:FindFirstAncestorOfClass("Model")
		local plr = model and Players:GetPlayerFromCharacter(model)
		if plr and plr ~= player and not hitModels[model] then
			local head = model:FindFirstChild("Head")
			if head then
				hitModels[model] = true
				task.spawn(call, "Remove", {head})
				task.delay(5, function()
					hitModels[model] = nil
				end)
			end
		end
	end
end

local function rise(c, cframeAt, startY, endY)
	for s = 1, RISE_STEPS do
		local y = startY + (endY - startY) * (s / RISE_STEPS)
		call("SyncMove", {{Part = c.part, CFrame = cframeAt(y)}})
		checkHits(c.part)
		task.wait(RISE_STEP_WAIT)
	end
	-- stay up for 0.5s, still checking for hits
	for _ = 1, 5 do
		checkHits(c.part)
		task.wait(0.1)
	end
	call("Remove", {c.part})
end

inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if stopped or gameProcessed or not readyPool then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	-- take the prepared batch, and immediately start preparing the next one
	local pool = readyPool
	readyPool = nil
	task.spawn(refillPool)

	if animTrack then
		animTrack:Play()
	end

	local origin = root.Position
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit

	-- plan every cylinder (position under the ground ahead + its own random rotation)
	local plans, moves = {}, {}
	for k = 1, CYL_COUNT do
		local c = pool[k]
		if c then
			local pos = origin + flat * (4 + (k - 1) * CYL_SPACING)
			local gy = groundY(pos)
			local rx = rad(math.random(-30, 30))
			local ry = rad(math.random(0, 360))
			local rz = rad(math.random(-30, 30))
			local function cframeAt(y)
				return CF(pos.X, y, pos.Z) * ANG(rx, ry, rz) * ANG(0, 0, rad(90))
			end
			-- fully hidden: half height + half diameter covers the tilt, plus a safety margin
			local startY = gy - c.height / 2 - c.diameter / 2 - HIDE_MARGIN
			local endY = gy + c.height / 2 -- standing on the ground
			plans[k] = {c = c, cframeAt = cframeAt, startY = startY, endY = endY}
			table.insert(moves, {Part = c.part, CFrame = cframeAt(startY)})
		end
	end

	-- one batched move puts all prepared cylinders under their spots
	call("SyncMove", moves)

	-- then they erupt one after another
	for k = 1, CYL_COUNT do
		local p = plans[k]
		if p then
			task.spawn(rise, p.c, p.cframeAt, p.startY, p.endY)
			task.wait(CYL_DELAY)
		end
	end
end)

