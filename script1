local function sendChat(msg)
	return pcall(function()
		local TextChatService = game:GetService("TextChatService")
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and channels:FindFirstChild("RBXGeneral")
			assert(general, "RBXGeneral channel not found")
			general:SendAsync(msg)
		else
			local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			local say = events and events:FindFirstChild("SayMessageRequest")
			assert(say, "SayMessageRequest not found")
			say:FireServer(msg, "All")
		end
	end)
end

local function sendHDAdmin(cmd)
	local ok = pcall(function()
		local client = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
		local signals = client and client:FindFirstChild("Signals")
		local remote = signals and (signals:FindFirstChild("RequestCommandSilent") or signals:FindFirstChild("RequestCommand"))
		assert(remote, "HD Admin remote not found")
		if remote:IsA("RemoteFunction") then
			remote:InvokeServer(cmd)
		else
			remote:FireServer(cmd)
		end
	end)
	if ok then
		return true
	end
	-- no HD Admin remote in this game -> send it as a normal chat message
	if sendChat(cmd) then
		return true
	end
	warn("[RainbowWings] Could not send command (HD Admin remote and chat both failed): " .. cmd)
	return false
end

