	blLbl.TextColor3 = Color3.fromHSV((hue + 0.75) % 1, 1, 1)
	topLbl.TextColor3 = Color3.fromHSV((hue + 0.33) % 1, 1, 1)
	botLbl.TextColor3 = Color3.fromHSV((hue + 0.66) % 1, 1, 1)
	topLine.BackgroundColor3 = col
	botLine.BackgroundColor3 = inv

	-- نوارهای متحرک
	local w = topBar.AbsoluteSize.X
	topX -= 140 * dt
	if topX + topLbl.AbsoluteSize.X < 0 then topX = w end
	topLbl.Position = UDim2.fromOffset(topX, 0)

	botX += 170 * dt
	if botX > w then botX = -botLbl.AbsoluteSize.X end
	botLbl.Position = UDim2.fromOffset(botX, 0)

	-- لرزش ریز فقط روی عنوان گوشه
	setTitleOffset(title, rng:NextNumber(-0.6, 0.6), rng:NextNumber(-0.6, 0.6))

	-- گلیچ تصادفی روی عنوان
	glitchTimer -= dt
