-- 2) Find F3X SyncAPI
----------------------------------------------------------------
local function findSync()
	for _, container in ipairs({player:FindFirstChildOfClass("Backpack"), char}) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					local api = tool:FindFirstChild("SyncAPI")
					local ep = api and api:FindFirstChild("ServerEndpoint")
					if ep then
						return ep
					end
				end
			end
		end
	end
end

local Sync = findSync()
if not Sync then
	warn("[RainbowWings] F3X Building Tools not found in Backpack/Character.")
	return
end

local function call(...)
	local args = {...}
	local ok, res = pcall(function()
		return Sync:InvokeServer(unpack(args))
	end)
	if not ok then
		warn("[RainbowWings] SyncAPI error: " .. tostring(res))
		return nil
	end
	return res
end

----------------------------------------------------------------
-- 3) Compute layout (static pose = wings at mid-flap)
----------------------------------------------------------------
local specs = {} -- {cframe, size, hue}

local handle = torso.CFrame * CF(0, 1.5, 1.05)

-- wings
local posX = {2, 3, 3.75, 4.75, 5.75, 6.75}
local posY = {0, 1, 2, 3, 4, 5}
local aX = {5, 10, 15, 20, 25, 30}
local aZ = {12.5, 25, 37.5, 50, 62.5, 75}

local pieces = {
	{size = Vector3.new(0.05, 0.5, 0.5), c1 = CF(0, 0, 0.25) * ANG(0, rad(90), 0)},
	{size = Vector3.new(0.05, 0.5, 0.5), c1 = CF(0, 0, 0.25) * ANG(0, rad(-90), 0)},
	{size = Vector3.new(0.05, 0.5, 3), c1 = CF(0, -0.25, 1.75) * ANG(0, rad(90), rad(90))},
	{size = Vector3.new(0.05, 3, 0.5), c1 = CF(0, -1.75, 0.25) * ANG(rad(90), rad(90), rad(90))},
}

for side = -1, 1, 2 do
	for i = 1, 6 do
		local wingC1 = CF(side * posX[i], posY[i], 0) * ANG(rad(aX[i]), 0, rad(side * aZ[i]))
		local root = handle * wingC1:Inverse()
		for _, p in ipairs(pieces) do
			table.insert(specs, {
				cframe = root * p.c1:Inverse(),
				size = p.size,
				hue = i / 6,
				type = "Wedge",
			})
		end
	end
end

-- halo rings
local function addRing(offset, r, segments, segLen)
	local center = torso.CFrame * CF(offset.X, -offset.Y, -offset.Z)
	for i = 1, segments do
		local c1 = CF(0, r, 0) * ANG(0, 0, rad(i * (360 / segments)))
		table.insert(specs, {
			cframe = center * c1:Inverse(),
			size = Vector3.new(segLen, 0.1 * r, 0.1 * r),
			hue = i / segments,
			type = "Normal",
		})
	end
end

addRing(Vector3.new(0, -1.5, -1.05), 1, 24, 0.27)
addRing(Vector3.new(0, -3, -2.1), 2, 32, 0.4)

-- remember every spec relative to the torso (so it can be re-placed later)
do
	local inv = torso.CFrame:Inverse()
	for _, s in ipairs(specs) do
		s.rel = inv * s.cframe
	end
end

----------------------------------------------------------------
-- 4) Build with F3X
----------------------------------------------------------------
local parts = {}
local entries = {}

-- batched creation: fire many CreatePart calls in parallel, wait for each batch
local BATCH_SIZE = 40
for start = 1, #specs, BATCH_SIZE do
	local finish = math.min(start + BATCH_SIZE - 1, #specs)
	local pending = finish - start + 1
	if stopped then
		return
	end
	for idx = start, finish do
		task.spawn(function()
			local s = specs[idx]
			s.part = call("CreatePart", s.type, s.cframe, workspace)
			pending -= 1
		end)
	end
	while pending > 0 do
		task.wait()
	end
end

for _, s in ipairs(specs) do
	if s.part then
		table.insert(parts, s.part)
		table.insert(entries, {part = s.part, hue = s.hue})
	end
end

if #parts == 0 then
	warn("[RainbowWings] No parts were created.")
	return
end

-- Freeze our character while the wings are positioned and welded, and re-place every
-- part from the torso's CURRENT position (it may have moved while the parts were created).
root.Anchored = true
local baseCF = torso.CFrame
for _, s in ipairs(specs) do
	s.cframe = baseCF * s.rel
end

local resize, collide, material, anchor, anchorOn = {}, {}, {}, {}, {}
for _, s in ipairs(specs) do
	if s.part then
		table.insert(anchorOn, {Part = s.part, Anchored = true})
		table.insert(resize, {Part = s.part, CFrame = s.cframe, Size = s.size})
		table.insert(collide, {Part = s.part, CanCollide = false})
		table.insert(material, {Part = s.part, Material = Enum.Material.Neon})
		table.insert(anchor, {Part = s.part, Anchored = false})
	end
end

call("SyncAnchor", anchorOn) -- keep parts still while they are placed
call("SyncResize", resize)
call("SyncCollision", collide)
call("SyncMaterial", material)

-- weld everything to the torso so the wings stay static on the body
call("CreateWelds", parts, torso)
call("SyncAnchor", anchor)
root.Anchored = false

-- every Neon part gets its own PointLight (server-side, via F3X)
local LIGHT_COLOR = Color3.fromRGB(255, 220, 0)
local function addLights(list)
	local create = {}
	local sync = {}
	for _, e in ipairs(list) do
		table.insert(create, {Part = e.part, LightType = "PointLight"})
		table.insert(sync, {
			Part = e.part,
			LightType = "PointLight",
			Color = LIGHT_COLOR, -- fixed yellow, never changes
			Brightness = 1,
			Range = 8,
		})
	end
	call("CreateLights", create)
	call("SyncLighting", sync)
end

addLights(entries)

