local conn
conn = RunService.RenderStepped:Connect(function(dt)
	t += dt

	-- رنگ RGB
	local hue = (t * 0.25) % 1
	local col = Color3.fromHSV(hue, 1, 1)
	local inv = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
