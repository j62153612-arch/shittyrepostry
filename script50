local spamToken = 0
local isSpamming = false

local function updateSpamVisuals()
    if isSpamming then
        spamBtn.BackgroundColor3 = ON_COLOR
        spamBtn.TextColor3 = ON_TEXT
    else
        spamBtn.BackgroundColor3 = SPAM_COLOR
        spamBtn.TextColor3 = SPAM_TEXT
    end
