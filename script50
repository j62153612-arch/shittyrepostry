local function getRate()
    local rate = tonumber(rateBox.Text)
    if not rate or rate ~= rate then rate = 5 end
    return math.clamp(rate, 1, 50)
end

local function startSpam()
    if not buildMessage() then
        flashFooter("Message is empty")
        return
    end

    isSpamming = true
    updateSpamVisuals()

    spamToken = spamToken + 1
    local myToken = spamToken

    task.spawn(function()
        while myToken == spamToken and msgBox.Parent and panel.Parent do
            local text = buildMessage()
            if text then
                pcall(sendNormal, text)
            end
            task.wait(1 / getRate())
        end
    end)

    flashFooter(("Spamming x%d/sec"):format(getRate()))
end

local function stopSpam(silent)
    local wasActive = isSpamming
    spamToken = spamToken + 1
    isSpamming = false
    updateSpamVisuals()
    if not silent then
        flashFooter(wasActive and "Spam stopped" or "Not spamming")
    end
end

--========================= MOVE TOOL ==========================
-- Studio-style arrows around every equipped tool. Dragging an arrow
-- changes Tool.GripPos (re-equipping the tool so the grip refreshes).
local isMoveTool = false
local moveHandles = {} -- [tool] = { part, folder, startGrip, pending, last }
local handlesRoot = mk("Folder", { Name = "MoveToolHandles" }, sg)

local MOVE_AXES = {
    { faces = { Enum.NormalId.Right, Enum.NormalId.Left },   color = Color3.fromRGB(255, 70, 70) },  -- X
    { faces = { Enum.NormalId.Top,   Enum.NormalId.Bottom }, color = Color3.fromRGB(70, 220, 90) },  -- Y
    { faces = { Enum.NormalId.Back,  Enum.NormalId.Front },  color = Color3.fromRGB(80, 140, 255) }, -- Z
}

local function round2(n)
    return math.floor(n * 100 + 0.5) / 100
end

local function getToolPart(tool)
    local h = tool:FindFirstChild("Handle")
    if h and h:IsA("BasePart") then
        return h
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            return d
        end
    end
    return nil
end

local function applyGrip(tool, pos)
    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not (char and backpack and tool.Parent == char) then return end
    tool.Parent = backpack
    pcall(function()
        tool.GripPos = pos
    end)
    tool.Parent = char
end

local function destroyToolHandles(tool)
    local data = moveHandles[tool]
    if data then
        moveHandles[tool] = nil
        pcall(function() data.folder:Destroy() end)
    end
end

local function createToolHandles(tool, part)
    local data = {
        part = part,
        folder = mk("Folder", { Name = "ToolHandles" }, handlesRoot),
        startGrip = nil,
        pending = nil,
        last = 0,
    }

    local function flush()
        if data.pending then
            applyGrip(tool, data.pending)
            data.pending = nil
        end
    end

    for _, axis in ipairs(MOVE_AXES) do
        local h = mk("Handles", {
            Adornee = part,
            Style = Enum.HandlesStyle.Movement,
            Faces = Faces.new(table.unpack(axis.faces)),
            Color3 = axis.color,
        }, data.folder)

        h.MouseButton1Down:Connect(function()
            data.startGrip = tool.GripPos
            data.pending = nil
        end)

        h.MouseDrag:Connect(function(face, distance)
            if not data.startGrip then
                data.startGrip = tool.GripPos
            end
            -- GripPos is expressed in the handle's local axes, inverted
            local np = data.startGrip - Vector3.FromNormalId(face) * distance
            np = Vector3.new(round2(np.X), round2(np.Y), round2(np.Z))
            data.pending = np

            local now = os.clock()
            if now - data.last >= 0.04 then
                data.last = now
                if np ~= tool.GripPos then
                    flush()
                    flashFooter(("GripPos  %.2f, %.2f, %.2f"):format(np.X, np.Y, np.Z), MOVE_COLOR)
                else
                    data.pending = nil
                end
            end
        end)

        h.MouseButton1Up:Connect(function()
            flush()
            data.startGrip = nil
        end)
    end

    moveHandles[tool] = data
end

local function syncMoveHandles()
    local char = player.Character
    local seen = {}

    if isMoveTool and char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local part = getToolPart(tool)
                if part then
                    seen[tool] = true
                    local data = moveHandles[tool]
                    if data and data.part ~= part then
                        destroyToolHandles(tool)
                        data = nil
                    end
                    if not data then
                        createToolHandles(tool, part)
                    end
                end
            end
        end
    end

    for tool in pairs(moveHandles) do
        if not seen[tool] then
            destroyToolHandles(tool)
        end
    end
end

local function setMoveTool(state)
    isMoveTool = state
    moveRow.setVisual(isMoveTool, true)
    syncMoveHandles()
    if state then
        flashFooter("Move Tool: equip a tool and drag the arrows", MOVE_COLOR)
    end
end

