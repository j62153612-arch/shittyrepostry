--========================= CHAT SEND ==========================
local function buildMessage()
    local raw = msgBox.Text
    raw = raw:gsub("\n", " ")
    raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
    if raw == "" then return nil end

    local tag = tagBox.Text
    tag = tag:gsub("^%s+", ""):gsub("%s+$", "")
    if tag ~= "" then
        return "[" .. tag .. "] " .. raw
    end
    return raw
end

-- Legacy chat system (SayMessageRequest)
local function sendLegacy(text)
    local holder = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local say = holder and holder:FindFirstChild("SayMessageRequest")
    if not say then return false end
    local ok = pcall(function()
        say:FireServer(text, "All")
    end)
    return ok
end

-- New TextChatService
local function sendTextChannel(text)
    local channels = TextService:FindFirstChild("TextChannels")
    if not channels then return false end

    local tries = {}
    local general = channels:FindFirstChild("RBXGeneral")
    if general then
        table.insert(tries, general)
    end
    for _, ch in ipairs(channels:GetChildren()) do
        if ch:IsA("TextChannel") and ch ~= general then
            table.insert(tries, ch)
        end
    end

    for _, ch in ipairs(tries) do
        local ok = pcall(function()
            ch:SendAsync(text)
        end)
        if ok then
            return true, ch.Name
        end
    end
    return false
end

local function sendNormal(text)
    if sendLegacy(text) then
        return true, "legacy"
    end
    local ok, channel = sendTextChannel(text)
    if ok then
        return true, channel
    end
    return false
end

