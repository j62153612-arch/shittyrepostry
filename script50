--========================= ROTATE TOOL ========================
-- Studio-style rotation arcs around every equipped tool. Dragging an
-- arc rotates the tool by changing Tool.Grip (same re-equip trick).
local isRotateTool = false
local rotateHandles = {} -- [tool] = { part, folder, startGrip, pending, last }

local ROTATE_AXES = {
    { axis = Enum.Axis.X, color = Color3.fromRGB(255, 70, 70) },
    { axis = Enum.Axis.Y, color = Color3.fromRGB(70, 220, 90) },
    { axis = Enum.Axis.Z, color = Color3.fromRGB(80, 140, 255) },
}

local function applyGripCF(tool, cf)
    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not (char and backpack and tool.Parent == char) then return end
    tool.Parent = backpack
    pcall(function()
        tool.Grip = cf
    end)
    tool.Parent = char
end

local function destroyRotateHandles(tool)
    local data = rotateHandles[tool]
    if data then
        rotateHandles[tool] = nil
        pcall(function() data.folder:Destroy() end)
    end
end

local function createRotateHandles(tool, part)
    local data = {
        part = part,
        folder = mk("Folder", { Name = "ToolArcs" }, handlesRoot),
        startGrip = nil,
        pending = nil,
        last = 0,
    }

    local function flush()
        if data.pending then
            applyGripCF(tool, data.pending)
            data.pending = nil
        end
    end

    for _, a in ipairs(ROTATE_AXES) do
        local h = mk("ArcHandles", {
            Adornee = part,
            Axes = Axes.new(a.axis),
            Color3 = a.color,
        }, data.folder)

        h.MouseButton1Down:Connect(function()
            data.startGrip = tool.Grip
            data.pending = nil
        end)

        h.MouseDrag:Connect(function(axis, relativeAngle)
            if not data.startGrip then
                data.startGrip = tool.Grip
            end
            -- snap to 1 degree
            local step = math.rad(1)
            local ang = math.floor(relativeAngle / step + 0.5) * step
            -- rotating the handle by Q means Grip' = Q^-1 * Grip
            local q = CFrame.fromAxisAngle(Vector3.FromAxis(axis), ang)
            data.pending = q:Inverse() * data.startGrip

            local now = os.clock()
            if now - data.last >= 0.04 then
                data.last = now
                if data.pending ~= tool.Grip then
                    flush()
                    flashFooter(("Rotate %s  %d deg"):format(axis.Name, math.round(math.deg(ang))), ROTATE_COLOR)
                else
                    data.pending = nil
                end
            end
        end)

        h.MouseButton1Up:Connect(function()
            flush()
            data.startGrip = nil
        end)
    end

    rotateHandles[tool] = data
end

local function syncRotateHandles()
    local char = player.Character
    local seen = {}

    if isRotateTool and char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local part = getToolPart(tool)
                if part then
                    seen[tool] = true
                    local data = rotateHandles[tool]
                    if data and data.part ~= part then
                        destroyRotateHandles(tool)
                        data = nil
                    end
                    if not data then
                        createRotateHandles(tool, part)
                    end
                end
            end
        end
    end

    for tool in pairs(rotateHandles) do
        if not seen[tool] then
            destroyRotateHandles(tool)
        end
    end
end

local function setRotateTool(state)
    isRotateTool = state
    rotateRow.setVisual(isRotateTool, true)
    syncRotateHandles()
    if state then
        flashFooter("Rotate Tool: equip a tool and drag the arcs", ROTATE_COLOR)
    end
end

track(RunService.Heartbeat:Connect(function()
    if isRotateTool then
        syncRotateHandles()
    end
end))

--==================== DISABLE TOOLNONE ANIM ==================
-- Roblox's default Animate script plays "ToolNoneAnim" (arm raised pose)
-- whenever a tool is held. While enabled, that track is stopped the
-- moment it starts, and re-checked every frame as a backup.
local isNoToolAnim = false
local hookedAnimator = nil
local hookConn = nil

local function isToolNoneTrack(trackObj)
    local anim = trackObj.Animation
    if trackObj.Name == "ToolNoneAnim" or (anim and anim.Name == "ToolNoneAnim") then
        return true
    end
    -- also match by AnimationId of the Animate script's toolnone animations
    local char = player.Character
    local animate = char and char:FindFirstChild("Animate")
    local toolNone = animate and animate:FindFirstChild("toolnone")
    if toolNone and anim then
        for _, a in ipairs(toolNone:GetChildren()) do
            if a:IsA("Animation") and a.AnimationId == anim.AnimationId then
                return true
            end
        end
    end
    return false
end

local function getAnimator()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum:FindFirstChildOfClass("Animator")
end

local function killToolNone(animator)
    for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
        if isToolNoneTrack(trackObj) then
            trackObj:Stop(0)
        end
    end
end

track(RunService.Heartbeat:Connect(function()
    local animator = getAnimator()
    if animator ~= hookedAnimator then
        if hookConn then
            hookConn:Disconnect()
            hookConn = nil
        end
        hookedAnimator = animator
        if animator then
            hookConn = animator.AnimationPlayed:Connect(function(trackObj)
                if isNoToolAnim and isToolNoneTrack(trackObj) then
                    trackObj:Stop(0)
                end
            end)
        end
    end
    if isNoToolAnim and animator then
        killToolNone(animator)
    end
end))

track({ Disconnect = function()
    if hookConn then
        hookConn:Disconnect()
        hookConn = nil
    end
end })

local function setNoToolAnim(state)
    isNoToolAnim = state
    noAnimRow.setVisual(isNoToolAnim, true)
    if state then
        local animator = getAnimator()
        if animator then
            killToolNone(animator)
        end
    end
end

