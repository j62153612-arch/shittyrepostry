--=========================== DRAG =============================
local function makeDraggable(targetFrame, handle)
    local uis = game:GetService("UserInputService")
    local tweenService = game:GetService("TweenService")
    handle = handle or targetFrame

    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    track(uis.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            tweenService:Create(targetFrame, TweenInfo.new(0.15), { Position = newPos }):Play()
        end
    end))
end

makeDraggable(panel, titleBar)

--===================== INVISIBILITY LOOP ======================
-- Exact original trick: every frame the character is moved 200000 studs
-- down and the camera offset is compensated, so the server sees you far
-- away while your own view stays where it was.
local camShift = nil      -- world shift to apply to the camera
local camHiddenPos = nil  -- where the root was while hidden

track(RunService.Heartbeat:Connect(function()
    camShift, camHiddenPos = nil, nil
    if not isEnabled then return end
    if SAFE_IN_SHIFT_LOCK
        and UserInput.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return
    end
    if not (rootPart and rootPart.Parent and humanoid and humanoid.Parent) then
        return
    end

    local oldCF = rootPart.CFrame
    local hideCF = oldCF * CFrame.new(0, -200000, 0)

    rootPart.CFrame = hideCF
    camHiddenPos = hideCF.Position
    camShift = oldCF.Position - hideCF.Position

    RunService.RenderStepped:Wait()

    pcall(function()
        -- keep any rotation applied meanwhile (shift lock turns the character)
        local currentRot = rootPart.CFrame.Rotation
        rootPart.CFrame = CFrame.new(oldCF.Position) * currentRot
    end)
end))

-- Right after Roblox updates the camera, move it back to the real position.
-- Only applied if the root really is at the hidden spot at that moment.
RunService:BindToRenderStep("InvisCamFix", Enum.RenderPriority.Camera.Value + 1, function()
    local cam = workspace.CurrentCamera
    if not (cam and camShift and camHiddenPos and rootPart and rootPart.Parent) then return end
    if (rootPart.Position - camHiddenPos).Magnitude > 50 then return end
    cam.CFrame = cam.CFrame + camShift
    cam.Focus = cam.Focus + camShift
end)
track({ Disconnect = function()
    pcall(function() RunService:UnbindFromRenderStep("InvisCamFix") end)
end })

