--=========================== HELPERS ==========================
local function mk(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

local function mkCorner(parent, radius)
    return mk("UICorner", { CornerRadius = radius or UDim.new(0, 8) }, parent)
end

local function mkStroke(parent, color, thickness, transparency)
    return mk("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, parent)
end

-- Tiny click cooldown so a single click can't toggle twice
local function debounce(fn, delay)
    local last = 0
    return function(...)
        local now = os.clock()
        if now - last < (delay or 0.15) then return end
        last = now
        fn(...)
    end
end

