local function GetVisualData(real)
    local meshes, textures = {}, {}
    for _, item in ipairs(real:GetDescendants()) do
        if item:IsA("SpecialMesh") then
            table.insert(meshes, {Part = nil, MeshType = item.MeshType, Scale = item.Scale, MeshId = item.MeshId, TextureId = item.TextureId})
        elseif item:IsA("Decal") or item:IsA("Texture") then
            table.insert(textures, {
                Part = nil, Face = item.Face, Texture = item.Texture, Transparency = item.Transparency,
                Color = item.Color3, TextureType = item.ClassName,
                OffsetStudsU = item:IsA("Texture") and item.OffsetStudsU or 0,
                OffsetStudsV = item:IsA("Texture") and item.OffsetStudsV or 0,
                StudsPerTileU = item:IsA("Texture") and item.StudsPerTileU or 1,
                StudsPerTileV = item:IsA("Texture") and item.StudsPerTileV or 1
            })
        end
    end
    if real:IsA("MeshPart") then
        table.insert(meshes, {Part = nil, MeshType = Enum.MeshType.FileMesh, Scale = Vector3.new(1,1,1), MeshId = real.MeshId, TextureId = real.TextureID})
    end
    return meshes, textures
end

local function TrackChanges(real, fake)
    local function update()
        if real.Parent and fake.Parent then
            
            remote:InvokeServer("SyncColor", {{Part = fake, Color = real.Color, Transparency = real.Transparency}})

            remote:InvokeServer("SyncResize", {{Part = fake, Size = real.Size, CFrame = real.CFrame}})
        end
    end
    
    real:GetPropertyChangedSignal("Color"):Connect(update)
    real:GetPropertyChangedSignal("Transparency"):Connect(update)
    real:GetPropertyChangedSignal("Size"):Connect(update)
    real:GetPropertyChangedSignal("Material"):Connect(update)

    for _, v in pairs(real:GetDescendants()) do

	if v:IsA("SpecialMesh") then

		local function syncMesh()
			remote:InvokeServer("SyncMesh", {{
				Part = fake,
				MeshType = v.MeshType,
				Scale = v.Scale,
				MeshId = v.MeshId,
				TextureId = v.TextureId
			}})
		end

		v:GetPropertyChangedSignal("MeshId"):Connect(syncMesh)
		v:GetPropertyChangedSignal("TextureId"):Connect(syncMesh)
		v:GetPropertyChangedSignal("Scale"):Connect(syncMesh)

	elseif v:IsA("Decal") or v:IsA("Texture") then

		local function syncTexture()
			remote:InvokeServer("SyncTexture", {{
				Part = fake,
				Face = v.Face,
				Texture = v.Texture,
				Transparency = v.Transparency,
				Color = v:IsA("Texture") and v.Color3 or nil,
				TextureType = v.ClassName,
				OffsetStudsU = v:IsA("Texture") and v.OffsetStudsU or 0,
				OffsetStudsV = v:IsA("Texture") and v.OffsetStudsV or 0,
				StudsPerTileU = v:IsA("Texture") and v.StudsPerTileU or 1,
				StudsPerTileV = v:IsA("Texture") and v.StudsPerTileV or 1
			}})
		end

		v:GetPropertyChangedSignal("Texture"):Connect(syncTexture)
		v:GetPropertyChangedSignal("Transparency"):Connect(syncTexture)

		if v:IsA("Texture") then
			v:GetPropertyChangedSignal("Color3"):Connect(syncTexture)
			v:GetPropertyChangedSignal("OffsetStudsU"):Connect(syncTexture)
			v:GetPropertyChangedSignal("OffsetStudsV"):Connect(syncTexture)
			v:GetPropertyChangedSignal("StudsPerTileU"):Connect(syncTexture)
			v:GetPropertyChangedSignal("StudsPerTileV"):Connect(syncTexture)
		end
	end
end
    

    if not _G.F3X_DeathCleanup then
	_G.F3X_DeathCleanup = true

	hum.Died:Connect(function()

		if _G.F3X_MoveLoop then
			_G.F3X_MoveLoop:Disconnect()
			_G.F3X_MoveLoop = nil
		end

		local removePacket = {}

		for real, fake in pairs(partMap) do
			if fake and fake.Parent then
				removePacket[#removePacket + 1] = fake
			end
		end

		if #removePacket > 0 then
			pcall(function()
				remote:InvokeServer("RemoveObjects", removePacket)
			end)
		end

		table.clear(partMap)

		if lastCF then
			table.clear(lastCF)
		end
	end)
end
