-- 飛行更新ループ
local function updateFly()
    if not flying then return end
    
    local forward = 0
    local side = 0
    
    if keysDown.w then forward = forward + 1 end
    if keysDown.s then forward = forward - 1 end
    if keysDown.a then side = side - 1 end
    if keysDown.d then side = side + 1 end
    
    local canFly = (forward ~= 0 or side ~= 0)
    
    if canFly then
        turnBG.Parent = RootPart
        floatBP.Parent = nil
        flyBV.Parent = RootPart
        
        flySpeed = flySpeed + 1 + (flySpeed / MAX_FLY_SPEED)
        if flySpeed > MAX_FLY_SPEED then 
            flySpeed = MAX_FLY_SPEED 
        end
    else
        floatBP.position = RootPart.Position
        floatBP.Parent = RootPart
        
        flySpeed = flySpeed - 1
        if flySpeed < 0 then 
            flySpeed = 0 
        end
    end
    
    local cam = workspace.CurrentCamera
    local camCF = cam.CoordinateFrame
    
    flyBV.velocity = ((camCF.lookVector * forward) + 
                     (camCF * CFrame.new(side, forward * 0.2, 0).p) - 
                     camCF.p) * flySpeed
    
    turnBG.cframe = camCF * CFrame.Angles(-math.rad(forward * (flySpeed / MAX_FLY_SPEED)), 0, 0)
end

