local function FindNearestTorso(Position, Distance)
    local List = {}
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Torso") and v ~= Character then
            if (v.Torso.Position - Position).Magnitude <= Distance then
                table.insert(List, v)
            end
        end
    end
    return List
end

local function CreatePart(size, cframe, color, material, transparency, parent)
    local part = Instance.new("Part", parent or workspace)
    part.Size = size
    part.CFrame = cframe
    part.BrickColor = BrickColor.new(color)
    part.Material = material or "SmoothPlastic"
    part.Transparency = transparency or 0
    part.Anchored = true
    part.CanCollide = false
    part.TopSurface = 10
    part.BottomSurface = 10
    return part
end

