local TAU = math.pi * 2
local PHI = 2.399963229728653
local sin, cos, sqrt, floor, ceil = math.sin, math.cos, math.sqrt, math.floor, math.ceil

local function fib(i, n, t)
    local y = 1 - 2 * (i - 0.5) / n
    local r = sqrt(math.max(0, 1 - y * y))
    local a = i * PHI + t
    return Vector3.new(cos(a) * r, y, sin(a) * r)
end

