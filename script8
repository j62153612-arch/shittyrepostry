-- Sliders (لگاریتمی برای رنج بزرگ + کادر تایپ مقدار)
local function makeSlider(y, name, min, max, init, step, cb)
    local holder = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, y), Size = UDim2.new(1, -20, 0, 44) }, panel)
    table.insert(hideWhenOpen, holder)
    local label = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(0.58, 0, 0, 22), Font = Enum.Font.GothamMedium,
        TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Text = name,
    }, holder)
    local box = new("TextBox", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.4, 0, 0, 22),
        BackgroundColor3 = C.item, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextColor3 = C.text, ClearTextOnFocus = false, Text = "", PlaceholderText = "value",
    }, holder)
    corner(box, 5)
    local bar = new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = C.item, BorderSizePixel = 0 }, holder)
    corner(bar, 4)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0 }, bar)
    corner(fill, 4)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, bar)
    corner(knob, 8)
    local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 22) }, holder)

    local logMin, logMax = math.log(min), math.log(max)
    local current = init

    -- exact = true یعنی مقدار تایپ‌شده (بدون گرد کردن به step)
    local function setValue(v, exact)
        v = math.clamp(v, min, max)
        if not exact then v = floor(v / step + 0.5) * step end
        v = math.clamp(tonumber(string.format("%.3f", v)), min, max)
        current = v
        local a = (math.log(v) - logMin) / (logMax - logMin)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        box.Text = tostring(v)
        cb(v)
    end
    local function fromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        setValue(math.exp(logMin + (logMax - logMin) * a))
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeSlider = fromX
            fromX(i.Position.X)
        end
    end)
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then setValue(num, true) else box.Text = tostring(current) end
    end)
    setValue(init, true)
end

