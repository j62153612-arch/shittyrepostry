-- ====== پیدا کردن SyncAPI ======
-- در F3X اصلی، SyncAPI یک Folder است و RemoteFunction واقعی داخلش
-- با اسم ServerEndpoint قرار دارد. هر دو حالت اینجا پشتیبانی می‌شود.
local function resolveEndpoint(obj)
	if not obj then return nil end
	if obj:IsA("RemoteFunction") then return obj end
	local ep = obj:FindFirstChild("ServerEndpoint")
	if ep and ep:IsA("RemoteFunction") then return ep end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("RemoteFunction") then return d end
	end
	return nil
end

local function findSyncAPI()
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for _, c in ipairs(containers) do
		if c then
			local tool = c:FindFirstChild("Building Tools")
			if tool then
				local ep = resolveEndpoint(tool:FindFirstChild("SyncAPI"))
				if ep then return ep end
			end
			for _, d in ipairs(c:GetDescendants()) do
				if d.Name == "SyncAPI" then
					local ep = resolveEndpoint(d)
					if ep then return ep end
				end
			end
		end
	end
	return nil
end

