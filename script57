-- ====== منطق ساخت ======
local busy = false
local builtParts = {}

local function setLockedAll(api, parts, locked)
	for i = 1, #parts, 200 do
		local chunk = {}
		for j = i, math.min(i + 199, #parts) do chunk[#chunk + 1] = parts[j] end
		local ok, err = pcall(function() api:InvokeServer("SetLocked", chunk, locked) end)
		if not ok then warn("[PixelText] SetLocked error:", tostring(err)) end
	end
end

local function removeAll(api)
	local function alive()
		local list = {}
		for _, part in ipairs(builtParts) do
			if typeof(part) == "Instance" and part.Parent then
				list[#list + 1] = part
			end
		end
		return list
	end

	-- Remove in chunks; retry once for anything that is still alive
	for _ = 1, 2 do
		local list = alive()
		if #list == 0 then break end
		setLockedAll(api, list, false)
		for i = 1, #list, 200 do
			local chunk = {}
			for j = i, math.min(i + 199, #list) do chunk[#chunk + 1] = list[j] end
			local ok, err = pcall(function() api:InvokeServer("Remove", chunk) end)
			if not ok then warn("[PixelText] Remove error:", tostring(err)) end
		end
		task.wait(0.3)
	end

	builtParts = alive()
	return #builtParts
end

local function buildInner(text)
	if busy then return end
	text = string.upper(text)
	if text:gsub("%s", "") == "" then
		status.Text = "Enter some text first"
		return
	end

	local api = findSyncAPI()
	if not api then
		status.Text = "Building Tools (SyncAPI) not found!"
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	busy = true
	status.Text = "Building..."

	-- if a text was built before, remove it first
	if #builtParts > 0 then
		status.Text = "Removing previous text..."
		removeAll(api)
		status.Text = "Building..."
	end

	-- محاسبه عرض کل
	local totalCols = 0
	for i = 1, #text do
		local ch = text:sub(i, i)
		totalCols += (ch == " " and SPACE_W or COLS) + GAP
	end
	totalCols -= GAP
	local totalWidth = totalCols * PIXEL_SIZE

	-- نقطه شروع: روبروی بازیکن، خوانا از دید او
	local origin = root.CFrame * CFrame.new(-totalWidth / 2, HEIGHT_OFFSET, -DISTANCE)

	local resizeData, colorData, anchorData = {}, {}, {}
	local count = 0
	local firstError = nil
	local colOffset = 0

	-- 1) first compute the list of all pixels
	local jobs = {}
	for i = 1, #text do
		local ch = text:sub(i, i)
		if ch == " " then
			colOffset += SPACE_W + GAP
		else
			local glyph = FONT[ch]
			if glyph then
				for row = 1, ROWS do
					for col = 1, COLS do
						if glyph[row]:sub(col, col) == "#" then
							local x = (colOffset + col - 1) * PIXEL_SIZE + PIXEL_SIZE / 2
							local y = (ROWS - row) * PIXEL_SIZE + PIXEL_SIZE / 2
							table.insert(jobs, origin * CFrame.new(x, y, 0))
						end
					end
				end
			end
			colOffset += COLS + GAP
		end
	end

	-- 2) Batch creation: make ONE template part, then "Clone" doubles the
	--    whole list in each call (1 -> 2 -> 4 -> 8 ...) so ~log2(N) requests total
	local results = {}
	local okT, template = pcall(function()
		return api:InvokeServer("CreatePart", "Normal", jobs[1], workspace)
	end)
	if not okT then
		firstError = tostring(template)
		warn("[PixelText] CreatePart error:", firstError)
	elseif template then
		pcall(function() api:InvokeServer("SyncAnchor", {{ Part = template, Anchored = true }}) end)
		results[1] = template
		while #results < #jobs do
			local slice = {}
			for i = 1, math.min(#results, #jobs - #results) do slice[i] = results[i] end
			local ok, clones = pcall(function()
				return api:InvokeServer("Clone", slice, workspace)
			end)
			if not ok or type(clones) ~= "table" or #clones == 0 then
				if not ok and not firstError then
					firstError = tostring(clones)
					warn("[PixelText] Clone error:", firstError)
				end
				break
			end
			for _, c in ipairs(clones) do results[#results + 1] = c end
			status.Text = "Building... " .. #results .. "/" .. #jobs
		end

		-- Fallback: if Clone isn't available, create the rest in parallel
		local startAt = #results + 1
		if startAt <= #jobs then
			local nextIndex, finished = startAt, startAt - 1
			for _ = 1, math.min(THREADS, #jobs - startAt + 1) do
				task.spawn(function()
					while nextIndex <= #jobs do
						local idx = nextIndex
						nextIndex += 1
						local ok, part = pcall(function()
							return api:InvokeServer("CreatePart", "Normal", jobs[idx], workspace)
						end)
						results[idx] = ok and part or false
						finished += 1
					end
				end)
			end
			while finished < #jobs do task.wait() end
		end
	end

	for idx = 1, #jobs do
		local part = results[idx]
		if part then
			table.insert(builtParts, part)
			table.insert(resizeData, {
				Part = part, CFrame = jobs[idx],
				Size = Vector3.new(PIXEL_SIZE, PIXEL_SIZE, PIXEL_SIZE), -- ضخامت = سایز
			})
			table.insert(colorData, { Part = part, Color = currentColor, UnionColoring = false })
			table.insert(anchorData, { Part = part, Anchored = true })
			count += 1
		end
	end

	pcall(function() api:InvokeServer("SyncResize", resizeData) end)
	pcall(function() api:InvokeServer("SyncColor", colorData) end)
	pcall(function() api:InvokeServer("SyncAnchor", anchorData) end)

	-- Lock last, after every other change is applied
	status.Text = "Locking..."
	setLockedAll(api, builtParts, true)
	task.wait(0.2)
	local function unlockedParts()
		local list = {}
		for _, part in ipairs(builtParts) do
			if typeof(part) == "Instance" and part.Parent and not part.Locked then
				list[#list + 1] = part
			end
		end
		return list
	end
	local notLocked = unlockedParts()
	if #notLocked > 0 then
		setLockedAll(api, notLocked, true) -- retry once
		task.wait(0.2)
		notLocked = unlockedParts()
	end

	if count == 0 then
		status.Text = "0 parts! " .. (firstError and "Error: see Output" or "Server returned nil")
	else
		status.Text = "Done! " .. count .. " parts" .. (#notLocked == 0 and " (locked)" or (" (" .. #notLocked .. " not locked)"))
	end
	busy = false
end

local function clear()
	if busy then
		status.Text = "Wait for the build to finish"
		return
	end
	if #builtParts == 0 then
		status.Text = "Nothing to clear"
		return
	end
	local api = findSyncAPI()
	if not api then
		status.Text = "SyncAPI not found!"
		return
	end

	busy = true
	status.Text = "Clearing..."
	local left = removeAll(api)
	if left == 0 then
		status.Text = "All texts cleared"
	else
		status.Text = "Could not remove " .. left .. " parts (see Output)"
	end
	busy = false
end

local function build(text)
	local ok, err = pcall(buildInner, text)
	if not ok then
		busy = false
		status.Text = "Error: see Output"
		warn("[PixelText] Build error:", tostring(err))
	end
end

