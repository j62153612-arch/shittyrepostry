local function applyRedLight(part)

	if not part or not part:IsA("BasePart") then return end

	local createArgs = {

		"CreateLights",

		{

			{

				Part = part,

				LightType = "PointLight"

			}

		}

	}

	local syncArgs = {

		"SyncLighting",

		{

			{

				Part = part,

				LightType = "PointLight",

				Color = Color3.fromRGB(255, 0, 0),

				Range = 60,

				Brightness = 2

			}

		}

	}

	invoke(createArgs)

	invoke(syncArgs)

end

    

    

